{
  "name": "stammbaum-der-goetter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interaktiver Stammbaum der griechischen und roemischen Goetter",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:schema": "node scripts/gen-schema.ts",
    "validate": "node scripts/validate.ts",
    "check:links": "node scripts/check-links.ts",
    "check:refs": "node scripts/check-refs.ts",
    "build:data": "node scripts/build-data.ts",
    "build:layout": "node scripts/build-layout.ts",
    "prepare:data": "npm run gen:schema && npm run validate && npm run build:data && npm run build:layout",
    "dev": "npm run prepare:data && vite",
    "prebuild": "npm run prepare:data && tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "elkjs": "^0.12.0",
    "js-yaml": "^5.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.1"
  }
}
